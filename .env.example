# Portal share-link tokens. A token IS the credential for these pages — anyone
# holding one can open the work behind it — so real values never enter the
# repository. Generate with:
#   node -e "console.log(require('crypto').randomBytes(9).toString('hex'))"
PORTAL_TOKEN_MICRUITY=mcr-replace-me
PORTAL_TOKEN_JANTA=jnt-replace-me
PORTAL_TOKEN_FYXIT=fyx-replace-me
PORTFOLIO_TOKEN_COLLAB=cc-replace-me

# Transactional mail for the contact form and portal notes.
RESEND_API_KEY=
