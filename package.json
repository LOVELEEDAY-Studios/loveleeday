{
  "name": "loveleeday",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/site-postprocess.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "capture": "python3 -W ignore scripts/capture-studies.py",
    "capture:check": "python3 -W ignore scripts/capture-studies.py --check",
    "prebuild": "node scripts/check-plain-language.mjs && node scripts/site-chrome.mjs && node scripts/share-cards.mjs && node scripts/check-site-consistency.mjs && node scripts/build-integrations-page.mjs --check",
    "cards": "node scripts/share-cards.mjs",
    "cards:check": "node scripts/share-cards.mjs --check",
    "hooks:install": "git config core.hooksPath scripts/git-hooks",
    "check:site": "node scripts/check-plain-language.mjs && node scripts/check-site-consistency.mjs && node scripts/build-integrations-page.mjs --check",
    "test:voice": "node --test scripts/check-plain-language.test.mjs",
    "check:site:live": "node scripts/check-site-consistency.mjs --live",
    "check:postprocess": "node scripts/site-postprocess.mjs --check",
    "chrome": "node scripts/site-chrome.mjs",
    "chrome:check": "node scripts/site-chrome.mjs --check"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "maplibre-gl": "^5",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.0",
    "shadcn": "^4.3.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "opentype.js": "^2.0.0",
    "playwright": "^1.59.1",
    "satori": "^0.35.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead",
    "not op_mini all"
  ]
}
